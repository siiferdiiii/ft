# Database connection strings (Supabase PostgreSQL)
# DATABASE_URL: pooled connection string (port 6543) for runtime API routes
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public"
# DIRECT_URL: direct connection string (port 5432) for prisma migrate
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public"

# Supabase Auth & Storage credentials
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
