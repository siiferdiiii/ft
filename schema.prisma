// schema.prisma — Finance Tracker
// Skema final, gabungan seluruh model dari desain-sistem-finance-tracker.md + PRD.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (pgbouncer, port 6543) — dipakai runtime app
  directUrl = env("DIRECT_URL")     // direct connection (port 5432) — dipakai migrasi (prisma migrate)
}

model User {
  id              String            @id // sama dengan auth.users.id dari Supabase Auth (UUID) — bukan default cuid()
  email           String            @unique // mirror dari auth.users.email, untuk kemudahan query/join
  name            String?
  perpetualFundPercent Int          @default(10) // persentase auto-suggest alokasi Dana Abadi, lihat PRD 4.8.2
  monthlyIncome   Decimal?          @db.Decimal(14, 2) // hasil interview AI budget, lihat PRD_AI_BUDGET_INTERVIEW.md — data sensitif, lihat SECURITY_STANDARDS.md
  wallets         Wallet[]
  categories      Category[]
  transactions    Transaction[]
  transfers       Transfer[]
  categoryKeywords CategoryKeyword[]
  aiInteractionLogs AiInteractionLog[]
  assets          Asset[]
  debts           Debt[]
  goals           Goal[]
  createdAt       DateTime          @default(now())
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           WalletType
  icon           String?
  color          String?
  balance        Decimal       @default(0) @db.Decimal(14, 2)
  isPerpetualFund Boolean      @default(false) // flag Dana Abadi, lihat PRD 4.8.1 — bukan tipe dompet baru
  isArchived     Boolean       @default(false)
  transactions   Transaction[]
  transfersFrom  Transfer[]    @relation("TransferFrom")
  transfersTo    Transfer[]    @relation("TransferTo")
  goal           Goal?         // dompet dedicated untuk satu goal, lihat PRD_GOALS.md — null kalau dompet biasa
  createdAt      DateTime      @default(now())

  @@index([userId])
}

enum WalletType {
  CASH
  EWALLET
  BANK
  OTHER
}

model Category {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String?
  type         TransactionType
  budgetLimit  Decimal?          @db.Decimal(14, 2)
  budgetPeriod BudgetPeriod      @default(MONTHLY)
  transactions Transaction[]
  keywords     CategoryKeyword[]
  createdAt    DateTime          @default(now())

  @@index([userId])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String
  wallet          Wallet          @relation(fields: [walletId], references: [id])
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  note            String?
  source          InputSource
  rawInput        String?
  receiptImageUrl String?
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([userId, transactionDate])
  @@index([walletId])
  @@index([categoryId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum InputSource {
  VOICE
  MANUAL
  RECEIPT_SCAN
}

model Transfer {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWalletId String
  fromWallet   Wallet   @relation("TransferFrom", fields: [fromWalletId], references: [id])
  toWalletId   String
  toWallet     Wallet   @relation("TransferTo", fields: [toWalletId], references: [id])
  amount       Decimal  @db.Decimal(14, 2)
  note         String?
  transferDate DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

model CategoryKeyword {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  frequency  Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([userId, keyword, categoryId])
}

model AffiliatePartner {
  id          String            @id @default(cuid())
  name        String
  category    AffiliateCategory
  description String            // ditulis manual oleh developer, bukan generated
  url         String            // link afiliasi
  disclaimer  String?           // override disclaimer default per kategori kalau perlu kasus khusus
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
}

enum AffiliateCategory {
  INVESTMENT   // platform investasi
  TOOLS        // alat/produk yang membantu menghasilkan lebih banyak uang
}

model AiInteractionLog {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AiInteractionType
  createdAt DateTime            @default(now())

  @@index([userId, createdAt]) // dipakai untuk hitung kuota harian, lihat PRD_AI_BUDGET_VOICE.md
}

enum AiInteractionType {
  QNA
  BUDGET_SUGGESTION
  PROACTIVE_ALERT
}

model Asset {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String              // nama bebas, mis. "Rumah di Bandung", "Motor Vario", "Emas 10gr"
  category        String              // kategori bebas diisi user, bukan enum tetap — mis. "Properti", "Kendaraan", "Investasi"
  value           Decimal             @db.Decimal(16, 2) // nilai terkini, diupdate manual oleh user
  liquidityTier   AssetLiquidityTier
  lastValuationAt DateTime            @default(now()) // kapan terakhir nilai diupdate, lihat PRD_ASET_UTANG.md
  isArchived      Boolean             @default(false)
  createdAt       DateTime            @default(now())

  @@index([userId])
}

enum AssetLiquidityTier {
  INSTANT  // cash, e-wallet, tabungan — bisa dicairkan <1 hari
  T3       // reksadana pasar uang, saham, deposito jangka pendek — bisa cair dalam ~3 hari kerja
  ILLIQUID // properti, kendaraan, barang koleksi — tidak bisa cepat dicairkan
}

model Debt {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String    // nama bebas, mis. "KPR", "Cicilan Motor"
  principal        Decimal   @db.Decimal(16, 2) // total utang awal
  remainingBalance Decimal   @db.Decimal(16, 2) // sisa utang berjalan
  monthlyPayment   Decimal?  @db.Decimal(14, 2) // nominal cicilan per bulan
  dueDayOfMonth    Int?      // tanggal jatuh tempo tiap bulan (1-31), untuk reminder
  interestRate     Decimal?  @db.Decimal(5, 2) // opsional, % per tahun
  isPaidOff        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Goal {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    // bebas, mis. "Beli Motor", "Dana Darurat"
  targetAmount      Decimal   @db.Decimal(14, 2)
  targetDate        DateTime? // opsional
  allocationPercent Int       @default(5) // persentase auto-suggest dari tiap pemasukan, per goal — lihat PRD_GOALS.md
  walletId          String    @unique // 1:1 — dompet dedicated tempat dana goal ini benar-benar disimpan
  wallet            Wallet    @relation(fields: [walletId], references: [id])
  isCompleted       Boolean   @default(false)
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([userId])
}
